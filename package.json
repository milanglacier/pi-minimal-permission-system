{
  "name": "pi-minimal-permission-system",
  "version": "1.2.0",
  "description": "Minimal permission enforcement extension for the Pi coding agent.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milanglacier/pi-minimal-permission-system.git"
  },
  "homepage": "https://github.com/milanglacier/pi-minimal-permission-system",
  "bugs": {
    "url": "https://github.com/milanglacier/pi-minimal-permission-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx ./tests/permission-system.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "permissions"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.91.0",
    "@types/node": "^22.10.5",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
